+.roster-switch::after { position: absolute; content: ""; left: 2px; top: 2px; width: 14px; height: 14px; border-radius: 50%; background: #68796e; transition: transform .15s; }
+.roster-switch:checked { background: var(--green); border-color: var(--green); }
+.roster-switch:checked::after { transform: translateX(15px); background: #fff; }
+.remove-button { min-height: 30px; padding: 3px 7px; border-color: var(--border); background: white; color: var(--red); font-size: .72rem; }
+.remove-button:hover:not(:disabled) { background: var(--red-bg); }
+.roster-empty { padding: 18px 0; color: var(--muted); font-size: .83rem; }
+
+.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+
+@media (max-width: 950px) {
+  .shell { width: calc(100% - 48px); }
+  .dashboard { gap: 17px; grid-template-columns: minmax(0, 1fr) minmax(220px, 250px); }
+  .sidebar-card { padding: 15px; }
+}
+
+@media (max-width: 720px) {
+  .shell { width: calc(100% - 34px); }
+  .header-inner { min-height: 62px; }
+  .hero { min-height: 0; margin-block: 20px 28px; padding: 26px 22px; border-radius: 19px; align-items: flex-start; gap: 18px; }
+  .hero-content { gap: 12px; }
+  .hero-date { padding: 9px 11px; gap: 4px; }
+  .hero-date-label { gap: 8px; font-size: .65rem; }
+  .hero-date time { font-size: .95rem; }
+  .dashboard { grid-template-columns: minmax(0, 1fr); gap: 23px; }
+  .sidebar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+}
+
+@media (max-width: 475px) {
+  .shell { width: calc(100% - 26px); }
+  .hero { flex-direction: column; }
+  .hero-date { display: flex; align-items: center; gap: 10px; }
+  .hero-date-label > span { display: none; }
+  .hero-date time::after { content: " JST"; font-size: .68rem; color: #e1ebdd; }
+  .sidebar { grid-template-columns: minmax(0, 1fr); }
+  .tabs { gap: 2px; }
+  .tab { gap: 4px; min-height: 37px; font-size: .76rem; }
+  .filters { gap: 6px; }
+  .search-field { padding-left: 10px; gap: 7px; }
+  .search-field input, .select-field select { font-size: .75rem; }
+  .stream { grid-template-columns: 88px minmax(0, 1fr); padding: 8px; gap: 9px; }
+  .stream-arrow { display: none; }
+  .stream-title { font-size: .82rem; }
+  .stream-meta, .stream-channel { font-size: .72rem; }
+  .dialog-header, .dialog-content { padding-inline: 14px; }
+  .roster-row { gap: 6px; }
+  .roster-switch-label > span { width: 1px; height: 1px; position: absolute; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
+}
